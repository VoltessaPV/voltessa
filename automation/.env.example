# FusionSolar portal login for the Atlanta plant's account. Never logged,
# never sent to Voltessa - this service is the only place these are read.
FUSIONSOLAR_ATLANTA_USERNAME=
FUSIONSOLAR_ATLANTA_PASSWORD=

# Shared secret Voltessa (apps/web) must send as `x-automation-secret` on
# every request. Same shape as the existing FUSIONSOLAR_GATEWAY_SECRET/
# CRON_SECRET pattern already used elsewhere in this codebase.
AUTOMATION_SERVICE_SECRET=

# Port this service listens on.
PORT=4100
