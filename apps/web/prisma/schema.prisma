generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OWNER
  OPERATOR
  VIEWER
}

/// Commercial persona, not an authorization signal — see ADR-014 (docs/ARCHITECT_DECISIONS.md).
enum AccountType {
  PLANT_OWNER
  ENERGY_TRADER
}

model User {
  id    String  @id @default(cuid())
  name  String?
  email String? @unique

  /// Authentication System Refresh, Phase 2. Set once via
  /// `EmailVerificationToken` - required before `signInWithPassword` grants
  /// a session for a password account. Always null for a Google-only
  /// account today (Google sign-in doesn't check or set this column - see
  /// `lib/auth/config.ts`); every Google sign-in is trusted unconditionally
  /// regardless of this field's value, and no verification email is ever
  /// sent to one.
  emailVerified DateTime?
  image         String?

  role UserRole @default(VIEWER)

  /// Commercial persona only — never read by the authorization layer. See ADR-014.
  accountType AccountType @default(PLANT_OWNER)

  /// Authorization flag: internal Voltessa staff, cross-organization reach. See ADR-014.
  isPlatformAdmin Boolean @default(false)

  /// Temporary suspension, reversible. Distinct from `deletedAt` below. See ADR-014.
  deactivatedAt DateTime?

  /// Soft delete — recoverable, preserves historical references. See ADR-014.
  deletedAt DateTime?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  accounts Account[]
  sessions Session[]

  traderAssignments        TraderAssignment[] @relation("TraderAssignments")
  traderAssignmentsGranted TraderAssignment[] @relation("TraderAssignmentsGranted")

  impersonationsStarted  ImpersonationSession[] @relation("ImpersonationsStarted")
  impersonationsReceived ImpersonationSession[] @relation("ImpersonationsReceived")

  auditLogsActed    AuditLog[] @relation("AuditLogsActed")
  auditLogsTargeted AuditLog[] @relation("AuditLogsTargeted")

  historicalImportJobsCreated HistoricalImportJob[]

  traderProfile TraderProfile?

  /// Settings > Profile. Kept separate from the pre-existing `name` (used by
  /// NextAuth's own Google profile sync and AppHeader's display) rather than
  /// parsing/splitting it — `updateProfile` keeps `name` in sync from these
  /// two fields so existing `name`-reading code needs no changes.
  firstName String?
  lastName  String?
  phone     String?

  /// Settings > Security, and (Authentication System Refresh) email/password
  /// sign-in at /login and /create-account. Null for a Google-only account
  /// (no local password ever set) - see `lib/auth/password.ts`. Format:
  /// "<saltHex>:<hashHex>" (Node's built-in `crypto.scrypt`, no extra
  /// dependency). Never read via NextAuth's Credentials provider - that
  /// provider always mints a JWT session cookie, incompatible with this
  /// app's database session strategy (see `lib/auth/create-session.ts`) -
  /// password sign-in is a custom Server Action instead.
  passwordHash String?

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  notificationPreferences NotificationPreferences?

  /// GDPR + Cookie Consent Platform milestone. Nullable and `onDelete: SetNull`
  /// deliberately: most consent decisions happen before signup (no User row
  /// yet), and when an account is later deleted (`deleteAccount()`), the
  /// consent history survives (per the agreed retention policy) but loses
  /// its identifying link - see `ConsentLog` below.
  consentLogs ConsentLog[]

  /// Full Internationalization milestone. The signed-in user's stored
  /// language preference - `null` means "not yet decided" (a real, distinct
  /// state, same convention as `AutomationState.currentExportMode`), not an
  /// error. Resolution order (lib/i18n/locale-resolution.ts): this field,
  /// then the `voltessa-locale` cookie, then `Accept-Language`, then
  /// English. Kept in sync with the cookie at sign-in and on every explicit
  /// language switch - see `lib/auth/config.ts`'s `signIn` event and
  /// `lib/i18n/actions.ts`'s `setLocale` - so a preference follows the
  /// person across devices/browsers, not just the one that set it. A plain
  /// `String?`, not the `AppLocale` union (`lib/i18n/routing.ts`), since
  /// Prisma enums can't easily grow alongside `routing.ts`'s locale list as
  /// languages are added in later milestones - validated against
  /// `AppLocale` at every read/write call site instead.
  locale String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountType])
  @@index([isPlatformAdmin])
  @@index([deactivatedAt])
  @@index([deletedAt])
}

/// Customer acquisition relationship ("which trader brought this org to Voltessa"), one trader
/// per organization. See ADR-014.
model TraderAssignment {
  id             String   @id @default(cuid())
  traderId       String
  organizationId String
  assignedById   String
  createdAt      DateTime @default(now())

  trader       User         @relation("TraderAssignments", fields: [traderId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  assignedBy   User         @relation("TraderAssignmentsGranted", fields: [assignedById], references: [id])

  @@unique([organizationId])
  @@index([traderId])
}

/// Platform Administration milestone. Trader-specific business/profile
/// data, deliberately NOT added to `User` directly — same reasoning as
/// `NotificationPreferences` (per-identity data, not organization-tenant
/// data, so scoped by `userId` alone) and the same "dedicated model per
/// concern" precedent `BillingInformation`/`EnergyMarketSettings` already
/// set for organization-scoped business data. Every field nullable: a
/// trader profile may not exist yet (no self-service UI exists as of this
/// milestone - Platform Admin's own edit screen creates this row the first
/// time) and an existing one may be partially filled in.
model TraderProfile {
  id String @id @default(cuid())

  userId String @unique

  companyName String?

  /// References `lib/market/distribution/bg.ts`'s static DSO list by `id`,
  /// same non-foreign-key convention as `EnergyMarketSettings.dsoId`.
  distributionCompanyId String?

  /// Trader Self-Service Onboarding milestone. Same convention as
  /// `Organization.onboardingCompletedAt` - set once, the moment the
  /// trader submits their required profile fields (companyName,
  /// distributionCompanyId, plus firstName/lastName/phone on User itself).
  /// Distinct from Platform Admin editing this row (M3), which never sets
  /// this field - only the trader's own onboarding submission does.
  onboardingCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// No fixed expiry — ends via explicit stop, admin logout, or the admin's own session expiring.
/// See ADR-014.
model ImpersonationSession {
  id                String    @id @default(cuid())
  token             String    @unique
  adminUserId       String
  adminSessionToken String
  targetUserId      String
  adminIp           String?
  adminUserAgent    String?
  startedAt         DateTime  @default(now())
  endedAt           DateTime?

  admin  User @relation("ImpersonationsStarted", fields: [adminUserId], references: [id])
  target User @relation("ImpersonationsReceived", fields: [targetUserId], references: [id])

  @@index([adminUserId])
  @@index([targetUserId])
}

/// `action` is a plain string, matching the `AutomationEvent.type` convention. See ADR-014.
model AuditLog {
  id             String   @id @default(cuid())
  actorUserId    String
  targetUserId   String?
  organizationId String?
  action         String
  metadata       Json?
  createdAt      DateTime @default(now())

  actor  User  @relation("AuditLogsActed", fields: [actorUserId], references: [id])
  target User? @relation("AuditLogsTargeted", fields: [targetUserId], references: [id])

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetUserId])
}

/// Authentication System Refresh, Phase 2. Dedicated, single-purpose model
/// for email-verification tokens only - deliberately not sharing the
/// pre-existing `VerificationToken` table below (that model exists only
/// because the NextAuth Prisma adapter requires it; nothing in this app
/// uses it, and overloading it with a second, unrelated purpose was
/// explicitly rejected in favor of a dedicated model per token type).
/// Password reset uses its own equivalent model, `PasswordResetToken` below
/// - same reasoning, not shared with this one either. Not organization-
/// scoped - a token belongs to a `User` and email verification happens
/// before any organization exists, same exception `MarketPrice` documents
/// for its own, different reason.
///
/// One row per outstanding token: `sendVerificationEmail` deletes any
/// existing token(s) for the user before creating a new one, so a resend
/// invalidates the previous link rather than leaving two valid tokens
/// alive. Single-use - deleted immediately by `consumeEmailVerificationToken`
/// on successful verification, and on expiry.
model EmailVerificationToken {
  id String @id @default(cuid())

  userId String

  /// Cryptographically random (`crypto.randomBytes(32).toString("hex")`) -
  /// never a sequential or guessable identifier.
  token String @unique

  expiresAt DateTime

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Authentication System Refresh, Phase 2.1. Dedicated model, deliberately
/// not sharing `EmailVerificationToken` despite the identical shape - same
/// "explicit, single-purpose model per token type" preference that model's
/// own doc comment already records. One row per outstanding token:
/// `sendPasswordResetEmail` deletes any existing token(s) for the user
/// first, so requesting a new reset link invalidates a previous one rather
/// than leaving two valid tokens alive. Single-use - deleted immediately by
/// `consumePasswordResetToken` on successful consumption, and on expiry.
/// 60-minute expiry (shorter than email verification's 24 hours - a
/// password reset link is more sensitive to leak/replay than a signup
/// confirmation). Not organization-scoped, same reasoning as
/// `EmailVerificationToken`.
model PasswordResetToken {
  id String @id @default(cuid())

  userId String

  /// Cryptographically random (`crypto.randomBytes(32).toString("hex")`) -
  /// never a sequential or guessable identifier.
  token String @unique

  expiresAt DateTime

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String? @db.Text
  session_state String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Organization {
  id String @id @default(cuid())

  name String

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  onboardingCompletedAt DateTime?

  users                  User[]
  plants                 Plant[]
  fusionSolarConnections FusionSolarConnection[]
  traderAssignment       TraderAssignment?

  automationSettings AutomationSettings?
  automationState    AutomationState?
  automationEvents   AutomationEvent[]
  deviceTelemetry    DeviceTelemetry[]
  plantDailyKpis     PlantDailyKpi[]
  pvForecastRecords  PvForecastRecord[]
  mlForecastRecords  MlForecastRecord[]

  billingInformation   BillingInformation?
  energyMarketSettings EnergyMarketSettings?

  historicalImportJobs HistoricalImportJob[]
}

model Plant {
  id String @id @default(cuid())

  name String

  vendor String @default("Huawei")

  timezone String @default("Europe/Sofia")

  stationCode String?
  plantCode   String?

  capacityKw Decimal? @db.Decimal(10, 2)

  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  country String?
  city    String?
  address String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id])

  devices Device[]

  /// Deprecated (Telemetry Architecture Finalization milestone, ADR-010):
  /// no longer read or written by any code path — `syncFusionSolarPlantTelemetry`
  /// and the routes that called it were removed, replaced by
  /// `PlantDailyKpi`. Kept, table and relation both, purely as a historical
  /// record; a dedicated future cleanup migration will drop it once
  /// `PlantDailyKpi` has run in production for a while. Do not write to
  /// this relation.
  telemetrySnapshots PlantTelemetrySnapshot[]
  deviceTelemetry    DeviceTelemetry[]
  dailyKpis          PlantDailyKpi[]
  pvForecastRecords  PvForecastRecord[]
  mlForecastRecords  MlForecastRecord[]

  @@unique([organizationId, stationCode])
}

model FusionSolarConnection {
  id String @id @default(cuid())

  organizationId String

  provider String @default("HuaweiFusionSolar")

  accessToken  String  @db.Text
  refreshToken String? @db.Text

  tokenType String?
  scope     String?

  expiresAt DateTime?

  /// Database-First Telemetry Architecture milestone: synchronization
  /// coordination state, scoped to this connection (the correct boundary —
  /// this token and Huawei's own per-account rate limit are shared across
  /// every plant beneath it). Owned exclusively by
  /// `lib/fusionsolar/telemetry-sync-service.ts` — nothing else reads or
  /// writes these three fields.
  telemetrySyncStatus         SyncStatus @default(IDLE)
  /// Set when a sync run claims the lease; informational only.
  telemetrySyncStartedAt      DateTime?
  /// Claim expiry — lets a crashed/timed-out sync's lease be reclaimed by a
  /// later request instead of deadlocking this connection forever.
  telemetrySyncLeaseExpiresAt DateTime?
  /// Set only when a sync completes successfully. Freshness (whether a new
  /// sync is needed) is measured against this timestamp.
  telemetryLastSyncedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
}

/// Database-First Telemetry Architecture milestone —
/// `FusionSolarConnection.telemetrySyncStatus` only.
enum SyncStatus {
  IDLE
  RUNNING
}

model Device {
  id String @id @default(cuid())

  plantId String

  vendor String @default("Huawei")

  devDn     String
  devName   String
  devTypeId Int

  /// Huawei numeric device identifier.
  /// Used only for Huawei API calls (for example getDevRealKpi).
  /// Refreshed on every device synchronization.
  /// Not a Voltessa business identifier.
  huaweiDeviceId BigInt?

  esnCode String?
  invType String?
  model   String?

  optimizerNumber Int?
  softwareVersion String?

  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  deviceTelemetry DeviceTelemetry[]

  @@unique([plantId, devDn])
  @@index([plantId])
  @@index([esnCode])
}

/// Per-organization automation configuration. Foundation for the Voltessa
/// Automation MVP - the Decision Engine (lib/automation/export-decision.ts)
/// reads these values as plain business inputs; it never queries this model
/// itself. `energyTrader` is a free-text placeholder today so it can later
/// evolve into a real trader integration (e.g. becoming a foreign key into
/// a future TraderIntegration table) without renaming this field. Transfer
/// costs, imbalance costs, and margins are deliberately not modeled here -
/// later milestone.
model AutomationSettings {
  id String @id @default(cuid())

  organizationId String @unique

  automationEnabled Boolean @default(false)

  minimumExportPrice Decimal @default(15.00) @db.Decimal(10, 2)

  /// Currency the organization expects minimumExportPrice to be denominated
  /// in. Does not trigger any currency conversion today - MarketPrice rows
  /// read through the Market Price Provider are compared to
  /// minimumExportPrice assuming they already match (true for the current
  /// single-market/EUR MVP scope). Converting across currencies is explicit
  /// future work, not done here.
  currency String @default("EUR")

  energyTrader String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Settings > Billing Information. One row per organization (same 1:1 shape
/// as `AutomationSettings`) - invoicing/company-registration data, entirely
/// separate from automation configuration. Every field nullable: an
/// organization that hasn't filled this in yet is a valid, common state, not
/// an error.
model BillingInformation {
  id String @id @default(cuid())

  organizationId String @unique

  companyName String?

  /// Bulgarian Unified Identification Code ("ЕИК"/UIC) - the Commercial
  /// Register's company identifier, not a VAT number.
  uic String?

  vatNumber String?

  country    String?
  city       String?
  postalCode String?
  address    String?

  invoiceEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Settings > Energy Market. One row per organization - which country's
/// market this organization trades on and which licensed electricity
/// supplier they're contracted with, as configured by the user (not
/// inferred from telemetry/automation). `supplierId` is validated against
/// `lib/market/suppliers/bg.ts`'s static supplier list server-side on every
/// write - never trusted as an arbitrary client-submitted string - and is
/// intentionally not a foreign key, since the supplier list is static data,
/// not a database table.
model EnergyMarketSettings {
  id String @id @default(cuid())

  organizationId String @unique

  /// MVP scope is Bulgaria only (matches
  /// `lib/market-price/constants.ts`'s `SUPPORTED_BIDDING_ZONES`) - a plain
  /// string, not an enum, so a second country is adding a value, not a
  /// migration.
  country String @default("Bulgaria")

  supplierId String?

  /// References `lib/market/distribution/bg.ts`'s static DSO list by `id`,
  /// same non-foreign-key convention as `supplierId` above.
  dsoId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Settings > Notifications. One row per user (not per organization) -
/// which categories of automation events this specific person wants to be
/// notified about. Scoped by `userId` alone, the same shape `Account`/
/// `Session` already use, since this is per-identity preference data, not
/// organization-tenant data - see `docs/CODING_STANDARDS.md`'s multi-tenancy
/// rule, which this doesn't fall under for the same reason `Account`/
/// `Session` don't. Storage only as of this milestone - not yet read by
/// `lib/notifications/automation-notifications.ts`, which still notifies
/// unconditionally for its four categories; wiring these preferences into
/// actual notification dispatch is explicit future work.
model NotificationPreferences {
  id String @id @default(cuid())

  userId String @unique

  automationChanges Boolean @default(true)
  exportFailures    Boolean @default(true)
  priceAlerts       Boolean @default(false)
  dailySummary      Boolean @default(false)
  weeklySummary     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// The single source of truth for "what export mode is this organization's
/// plant currently in, as far as Voltessa's own automation is concerned" -
/// Market Price Optimization Execution Engine milestone. `currentExportMode`
/// is written ONLY after a successful Automation Service call (see
/// lib/automation/market-price-optimization-scheduler.ts) or a daily
/// reconciliation sync - never speculatively, never optimistically before
/// the call completes. Deliberately separate from AutomationSettings: that
/// model is user-edited configuration (threshold, enabled/disabled); this
/// one is system-derived execution state, written by a different actor on a
/// different cadence. `currentExportMode` uses the Automation Service's own
/// canonical vocabulary ("Zero Export" / "No Limit") directly - no
/// translation layer, since nothing else in this system needs a third
/// vocabulary for the same two states.
///
/// `isRunning`/`lockedAt` double this row as a per-organization,
/// DB-backed mutual-exclusion lock (acquired via a conditional
/// `updateMany` - see acquireAutomationExecutionLock): both the 15-minute
/// execution scheduler and the daily reconciliation job acquire it before
/// touching this row or writing an AutomationEvent, and release it when
/// done, so the two never run concurrently with each other or with
/// themselves for the same organization. A dedicated lock table was
/// considered and rejected - this row already exists per organization and
/// is exactly what needs protecting, so reusing it keeps the schema
/// smaller. An in-memory lock cannot work here: Vercel Functions are
/// stateless across invocations, so mutual exclusion has to live in the one
/// thing every invocation shares - the database.
model AutomationState {
  id String @id @default(cuid())

  organizationId String @unique

  /// Null until the first successful execution or reconciliation for this
  /// organization - "we don't know yet" is a real, distinct state from
  /// either mode.
  currentExportMode String?

  isRunning Boolean   @default(false)
  lockedAt  DateTime?

  /// Notification Provider milestone's anti-spam state for daily
  /// reconciliation failures (see lib/automation/daily-reconciliation.ts):
  /// true while reconciliation is currently unable to determine the real
  /// export mode (a fatal FusionSolar access problem - login/credentials/
  /// session/MFA failures). A "reconciliation_failed" AutomationEvent (and
  /// its notification) is only created on the transition INTO this state,
  /// never repeated on every subsequent day the same problem persists; a
  /// "reconciliation_restored" AutomationEvent (and its notification) is
  /// only created on the transition back OUT of it.
  reconciliationFailing Boolean @default(false)

  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// The automation event log (Market Price Optimization Execution Engine
/// milestone) - the "automation must always be traceable" principle from
/// CLAUDE.md applied to this engine specifically. Created ONLY when
/// something actually happened (a mode switch, a failure, a reconciliation
/// mismatch/sync/restore) - a normal scheduler tick that decides no action
/// is needed creates no row, by design (see decideExportAction's "NONE"
/// action and the scheduler's own skip-on-no-action logic).
///
/// Notification Provider milestone: creating a row here is also the single
/// trigger point for sending a user-facing notification (see
/// lib/notifications/automation-notifications.ts, called from
/// createAutomationEvent in lib/automation/automation-events.ts, AFTER this
/// row has actually committed) - not every `type` sends one; see that
/// module for the exact mapping. Callers (the scheduler/reconciliation
/// modules) never talk to a notification provider directly.
model AutomationEvent {
  id String @id @default(cuid())

  organizationId String

  /// Short, stable machine-readable kind, for future filtering/display -
  /// "mode_changed" | "automation_service_failed" |
  /// "reconciliation_mismatch" | "reconciliation_synced" |
  /// "reconciliation_failed" | "reconciliation_restored". Kept as a plain
  /// string (not a Prisma enum) so adding a new kind later never needs a
  /// migration, matching this schema's existing convention for this kind of
  /// small closed-but-growable vocabulary (see MarketPrice.source).
  type String

  /// Full Internationalization milestone: for `mode_changed`/
  /// `automation_service_failed` (the two USER_FACING_EVENT_TYPES,
  /// lib/automation/automation-events.ts), this is now a fixed, canonical
  /// value derivable from `type`+`newMode` alone ("switched" / "failed") -
  /// kept purely as a redundant, human-readable audit convenience, never
  /// read back for display. The actual UI/notification text is regenerated
  /// from `type`/`previousMode`/`newMode` via i18n at render time (see
  /// `lib/automation/automation-event-i18n.ts`) - this column is NOT
  /// re-displayed to end users directly. Previously held literal
  /// pre-rendered English prose ("Switched to Zero Export") shown as-is
  /// regardless of viewer locale - a real backend/presentation-layer
  /// violation this milestone fixed. Reconciliation event types are
  /// unaffected (internal/admin diagnostic text, out of this fix's scope).
  summary String

  /// Full Internationalization milestone: for `mode_changed` events, this
  /// is now `ExportDecisionReasonCode` (lib/automation/export-decision.ts)
  /// - a stable canonical code, e.g. "price_below_low_band" - never English
  /// prose. Translated at render/notification time via
  /// `lib/automation/automation-event-i18n.ts`'s `decisionReasons.*`
  /// mapping (`automations.json`), never stored pre-rendered. Previously
  /// held literal English sentences ("Price below low band") directly -
  /// the same violation `summary` above documents. For
  /// `automation_service_failed`, and for reconciliation event types, this
  /// remains free-form diagnostic text (the real transport/access error),
  /// out of this fix's scope - see `errorMessage` below for the
  /// user-facing failure-notification counterpart.
  reason String

  /// The real Automation Service/transport error, kept separate from
  /// `reason` only for a failed mode-change attempt - the notification for
  /// that case shows both "why Voltessa decided this" (`reason`) and "what
  /// actually went wrong" (`errorMessage`) as distinct fields. Null for
  /// every other event type.
  errorMessage String?

  previousMode String?
  newMode      String?

  currentPrice      Decimal? @db.Decimal(10, 4)
  nextIntervalPrice Decimal? @db.Decimal(10, 4)

  /// The AutomationSettings.minimumExportPrice in effect at decision time -
  /// captured here so the event (and its notification) stays accurate even
  /// if the user later changes the threshold. Only set for mode-change
  /// events (success or failure); null for reconciliation events, which
  /// aren't threshold-driven.
  threshold Decimal? @db.Decimal(10, 4)

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

/// Persisted, normalized market prices (currently: ENTSO-E day-ahead
/// electricity prices). Populated only by
/// lib/market-price/refresh-market-prices.ts via the ENTSO-E provider
/// (lib/market-price/providers/entsoe.ts) - never written to directly from
/// the Dashboard, Settings page, or Decision Engine. Read only through the
/// Market Price Provider (lib/market-price/provider.ts).
///
/// Deliberately NOT organization-scoped, unlike every other model in this
/// schema: a market price for a given bidding zone is a shared public
/// commodity value, not per-tenant data. This is a narrow, deliberate
/// exception to the multi-tenancy rule in ADR-002
/// (docs/ARCHITECT_DECISIONS.md), not an oversight.
model MarketPrice {
  id String @id @default(cuid())

  timestamp DateTime

  price Decimal @db.Decimal(10, 4)

  currency String @default("EUR")

  biddingZone String

  source String @default("ENTSOE")

  createdAt DateTime @default(now())

  @@unique([biddingZone, timestamp, source])
  @@index([biddingZone, timestamp])
}

/// Records the outcome of each market-price import run (see
/// lib/market-price/refresh-market-prices.ts). A single MarketPrice row
/// per interval can't represent "this interval is missing" (we never
/// fabricate a row for it), so this model exists to carry that status -
/// expectedIntervals/importedIntervals/isPartial/missingTimestamps - from
/// the importer through to the Dashboard via the Market Price Provider's
/// getLatestImportStatus(). Not organization-scoped, for the same reason
/// MarketPrice isn't - see that model's comment.
model MarketPriceImport {
  id String @id @default(cuid())

  biddingZone String

  periodStart DateTime
  periodEnd   DateTime

  resolutionMinutes Int

  expectedIntervals Int
  importedIntervals Int

  isPartial Boolean @default(false)

  /// ISO timestamps of intervals that were missing from the ENTSO-E
  /// response and were NOT fabricated or interpolated.
  missingTimestamps String[]

  source String @default("ENTSOE")

  importedAt DateTime @default(now())

  @@index([biddingZone, importedAt])
}

/// DEPRECATED (Telemetry Architecture Finalization milestone, ADR-010): the
/// pipeline that wrote this table (`syncFusionSolarPlantTelemetry`,
/// `ingestFusionSolarPlantTelemetry`, and the routes that called them) has
/// been removed — it called the same Huawei endpoint (`getStationRealKpi`)
/// `PlantDailyKpi` now owns, which would otherwise have meant two code
/// paths calling Huawei for the same data. No code reads or writes this
/// table anymore. Kept, table and data both, purely as a historical
/// record — dropping it is an explicit future cleanup migration, not done
/// here, so the 906 already-stored rows aren't lost.
model PlantTelemetrySnapshot {
  id String @id @default(cuid())

  plantId String

  totalIncome     Decimal? @db.Decimal(18, 4)
  totalPower      Decimal? @db.Decimal(18, 4)
  dayOnGridEnergy Decimal? @db.Decimal(18, 4)
  dayPower        Decimal? @db.Decimal(18, 4)
  dayUseEnergy    Decimal? @db.Decimal(18, 4)
  dayIncome       Decimal? @db.Decimal(18, 4)
  realHealthState Int?
  monthPower      Decimal? @db.Decimal(18, 4)

  collectedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@index([plantId, collectedAt])
}

/// Huawei's station-level daily KPI counters (`getStationRealKpi`),
/// persisted once per Scaleway ingestion cycle
/// (`bootstrap-device-telemetry` -> `import-plant-daily-kpi.ts`) — see
/// ADR-010. This is the authoritative source for Produced Today / Consumed
/// Today (`pvYieldKwh`/`consumptionKwh` = Huawei's own `day_power`/
/// `day_use_energy` counters), replacing the local power-integration
/// reconstruction that was found to disagree with Huawei by ~28%
/// (docs/research/energy-data-audit.md). Exported/Imported Today keep
/// coming from the meter's cumulative counters in `DeviceTelemetry`
/// (already within tolerance) — `exportedEnergyKwh` here is stored for
/// reference/reporting only, never as the Dashboard/Market display source.
///
/// Replaces the old `PlantTelemetrySnapshot` pipeline (dormant, unscheduled
/// — see ADR-008/ADR-009), which called this same Huawei endpoint
/// independently; that pipeline's code has been removed (keeping both would
/// have meant two code paths calling Huawei for the same data), though the
/// `PlantTelemetrySnapshot` table/data itself is kept as a historical
/// record — see that model's own doc comment. Only fields Huawei's
/// `getStationRealKpi` actually returns become typed columns; everything else in that response
/// (total_income/total_power/day_income/real_health_state/month_power) is
/// preserved unmodified in `rawPayload`, the same discipline
/// `DeviceTelemetry.rawPayload` already follows — no invented/calculated
/// fields. `importedEnergyKwh` has no corresponding Huawei field in this
/// endpoint's response and is always null; never derived locally.
model PlantDailyKpi {
  id String @id @default(cuid())

  organizationId String
  plantId        String

  /// The local (Europe/Sofia) calendar day this row represents, stored as
  /// that day's own UTC midnight instant (`localDayBoundsUtc`'s `start`) —
  /// must be computed with the exact same timezone convention every reader
  /// of this table uses (see `lib/telemetry/plant-daily-kpi.ts`), so the
  /// unique key always matches.
  localDate DateTime

  /// Huawei `day_power` — cumulative PV yield for the local day, kWh.
  pvYieldKwh        Decimal  @db.Decimal(12, 3)
  /// Huawei `day_use_energy` — cumulative site consumption for the local
  /// day, kWh.
  consumptionKwh    Decimal  @db.Decimal(12, 3)
  /// Huawei `day_on_grid_energy` — cumulative export for the local day,
  /// kWh. Reference only; display continues to use the meter counter.
  exportedEnergyKwh Decimal? @db.Decimal(12, 3)
  /// No Huawei station-KPI field currently provides this — always null.
  importedEnergyKwh Decimal? @db.Decimal(12, 3)

  source String @default("HuaweiFusionSolar")

  /// The complete, unmodified `dataItemMap` from `getStationRealKpi` for
  /// this station — same discipline as `DeviceTelemetry.rawPayload`.
  rawPayload Json

  ingestedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plant        Plant        @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([plantId, localDate])
  @@index([organizationId, plantId, localDate])
}

/// Resolution of a `DeviceTelemetry` sample. Only "5m" is populated as of the
/// telemetry bootstrap milestone (Huawei getDevFiveMinutes); "1h"/"1d" exist
/// so future aggregation/rollup jobs can write into the same table instead
/// of requiring a schema change.
enum TelemetryResolution {
  FIVE_MIN @map("5m")
  HOURLY   @map("1h")
  DAILY    @map("1d")
}

/// Voltessa's own telemetry store: a single, device-level, multi-resolution
/// table that every future consumer (Dashboard, Market, AI, Automation,
/// Revenue) reads from instead of importing from Huawei directly.
///
/// One row = one device's reading at one timestamp, at one resolution.
/// Deliberately not split per device type (inverter/meter) or per
/// resolution (5m/1h/1d) — see docs/AI_TASK_TEMPLATE.md task for this
/// milestone for the reasoning. Only the handful of KPIs actually queried
/// across every future layer (produced/exported/imported energy) are typed
/// columns; everything else Huawei returns is preserved unmodified in
/// `rawPayload` so no KPI is ever silently unavailable to future analytics.
///
/// Never store derived/business values here (revenue, profit, savings,
/// self-consumption, export decisions) — those belong to higher layers and
/// must always be computable from this table's raw data, never baked in.
model DeviceTelemetry {
  id String @id @default(cuid())

  organizationId String
  plantId        String
  deviceId       String

  /// Huawei's own numeric device identifier — denormalized from
  /// `Device.huaweiDeviceId` so this table is self-describing even if a
  /// device is later re-synced/re-mapped.
  huaweiDeviceId BigInt
  /// Huawei's device type (1 = inverter, 47 = meter, ...) — denormalized
  /// for the same reason.
  devTypeId      Int

  timestamp  DateTime
  resolution TelemetryResolution

  ingestedAt DateTime @default(now())
  /// Always "HuaweiFusionSolar" today; stored explicitly (not assumed) so a
  /// future second vendor never has to backfill this column.
  source     String   @default("HuaweiFusionSolar")

  /// Instantaneous inverter production, kW (Huawei dataItemMap.active_power
  /// on the inverter device type). Null for meter rows.
  activePower   Decimal? @db.Decimal(12, 3)
  /// Inverter operating state (Huawei dataItemMap.inverter_state). Null for
  /// meter rows.
  inverterState Int?
  /// Inverter temperature, °C (Huawei dataItemMap.temperature). Null for
  /// meter rows.
  temperature   Decimal? @db.Decimal(6, 2)

  /// Instantaneous grid exchange power, kW (Huawei dataItemMap.active_power
  /// on the meter device type — same Huawei field name as `activePower`
  /// above, but a different physical quantity, hence a separate column).
  /// Null for inverter rows.
  meterActivePower    Decimal? @db.Decimal(12, 3)
  /// Meter status (Huawei dataItemMap.meter_status). Null for inverter rows.
  meterStatus         Int?
  /// Cumulative EXPORT energy counter, kWh (Huawei dataItemMap.active_cap
  /// on the meter device type). Null for inverter rows — inverters report
  /// day/lifetime cumulative production under different, non-equivalent
  /// fields (day_cap/total_cap), preserved only in `rawPayload`, not
  /// conflated with this column.
  ///
  /// CORRECTED (Historical Backfill + Timeline Alignment / Mathematical
  /// Correctness milestone): this field's real meaning is the OPPOSITE of
  /// what its original doc comment claimed ("forward/active" was assumed
  /// to mean grid import). Proven empirically against real stored data,
  /// not Huawei's naming convention: across every real meter sample for
  /// this plant, this counter increases almost exclusively while
  /// `meterActivePower` is positive, and a 25-minute daytime window where
  /// power rose from 39 kW to 60 kW moved this counter by +19.38 kWh,
  /// matching a left-Riemann integration of that same window (19.57 kWh)
  /// to within 1% — i.e. this is the real cumulative EXPORT counter. See
  /// `lib/telemetry/energy-metrics.ts`'s module doc comment and
  /// `docs/research/telemetry-consumer-migration.md` §13 for the full
  /// investigation.
  activeEnergy        Decimal? @db.Decimal(14, 3)
  /// Cumulative IMPORT energy counter, kWh (Huawei
  /// dataItemMap.reverse_active_cap on the meter device type). Null for
  /// inverter rows.
  ///
  /// CORRECTED (same investigation as `activeEnergy` above): despite the
  /// "reverse/export" name Huawei's field suggests, this counter increases
  /// almost exclusively while `meterActivePower` is NEGATIVE (confirmed
  /// against real overnight standby-import windows) — i.e. this is the
  /// real cumulative IMPORT counter, not export.
  reverseActiveEnergy Decimal? @db.Decimal(14, 3)

  /// The complete, unmodified Huawei response item for this sample
  /// (devId/sn/collectTime/dataItemMap) — every KPI Huawei returns, not
  /// just the typed columns above. Future analytics reads this instead of
  /// re-importing from Huawei.
  rawPayload Json

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plant        Plant        @relation(fields: [plantId], references: [id], onDelete: Cascade)
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, timestamp, resolution])
  @@index([organizationId, plantId, timestamp])
  @@index([plantId, timestamp])
}

/// GDPR + Cookie Consent Platform milestone. Append-only proof-of-consent
/// record - the accountability-principle answer to "can we demonstrate this
/// person actually consented, and to what, at what time". Deliberately NOT
/// organization-scoped (no `organizationId`): consent is a per-person/per-
/// browser concept, not a tenant-business concept, and most rows are written
/// before any Organization exists (a marketing-site visitor pre-signup) -
/// same kind of documented multi-tenancy exception `MarketPrice` already
/// sets a precedent for in this schema, for the analogous reason.
///
/// A new row is written on every consent decision (first-visit
/// Accept All/Reject All/Customize, and any later change via Cookie
/// Settings) - never updated in place and never superseded/deleted when a
/// newer decision exists, per the agreed retention policy
/// (docs/legal/data-retention.md): the full history is the point, not just
/// the current state. `userId` is nullable with `onDelete: SetNull` since
/// most rows precede signup, and because deleting an account must not carry
/// the deleted person's identity forward via this table either - the
/// consent history for that browser survives (proof it was properly
/// requested/obtained) but the direct link to the now-deleted account does
/// not.
model ConsentLog {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Matches the `CONSENT_VERSION` constant in effect when this decision was
  /// recorded (`lib/consent/constants.ts`) - lets a later policy/category
  /// change be told apart from an earlier decision made under different
  /// terms.
  version Int

  necessary  Boolean @default(true)
  functional Boolean @default(false)
  analytics  Boolean @default(false)
  marketing  Boolean @default(false)

  /// "accept_all" | "reject_all" | "customize" - which control the person
  /// actually used, not just the resulting category booleans, since two
  /// different actions can produce the same booleans (e.g. Reject All vs.
  /// manually unchecking everything in Customize).
  action String

  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// GDPR + Cookie Consent Platform milestone. The ONLY record `deleteAccount()`
/// (app/(platform)/settings/actions.ts) writes when a user deletes their own
/// account - deliberately NOT the general-purpose `AuditLog` model above,
/// whose `metadata Json?` field and User relations (even with
/// `onDelete: SetNull`) invite exactly the kind of reconstructable/
/// identifying record this trail must never be. This model has no foreign
/// key to `User` at all, not even a nullable one: the account is genuinely
/// gone, and this row proves only that a self-service deletion happened,
/// never who it was. Retained indefinitely (see docs/legal/data-retention.md)
/// specifically BECAUSE it contains no personal data - the normal 24-month
/// log-retention window that applies to AuditLog/AutomationEvent/
/// ImpersonationSession/ConsentLog doesn't apply here for that same reason.
///
/// No hash of the deleted user's id was added, deliberately: Prisma `cuid()`
/// values are never reused, and this model exists for exactly one real
/// deletion event per account (there is no realistic "duplicate deletion"
/// scenario to detect once the row is gone) - adding a field "just in case"
/// would be exactly the kind of speculative field this milestone's own
/// minimal-data requirement argues against.
model AccountDeletionRecord {
  id String @id @default(cuid())

  /// Always "self_service" today - the admin-initiated purge path
  /// (`app/(platform)/admin/actions.ts`'s `purgeUser`) already has its own
  /// `AuditLog` trail and is out of scope for this model.
  actorType String @default("self_service")

  /// Fixed, closed vocabulary - "account_deleted" is the only value today.
  actionType String @default("account_deleted")

  /// `crypto.randomUUID()`, generated at deletion time - lets this row be
  /// correlated with the deletion Server Action's own server-side log line
  /// for support/debugging, without storing anything about the account
  /// itself.
  correlationId String @unique

  schemaVersion Int @default(1)

  createdAt DateTime @default(now())
}

/// Platform Health & Operations Center milestone. Shared across
/// `SchedulerRun`/`ImporterRun` — a run either fully succeeded, threw/
/// returned a failure outcome, or was a legitimate no-op (already fresh,
/// already running, nothing to do). `SKIPPED` is not a failure: Sections 4/5
/// of the Operations Center must be able to tell "nothing needed doing" from
/// "something went wrong" without inferring it from prose.
enum RunStatus {
  SUCCESS
  FAILED
  SKIPPED
}

/// Platform Health & Operations Center milestone (Section 5, Scheduler
/// Health). One row per HTTP invocation of one of the four
/// `app/api/internal/**` routes the Scaleway systemd timers call
/// (`voltessa-telemetry-ingestion`, `voltessa-market-price-scheduler`,
/// `voltessa-automation-execution`, `voltessa-automation-reconciliation` —
/// see `docs/infrastructure/scaleway-production.md`). `schedulerName` is a
/// plain string, not an enum, matching this schema's existing convention for
/// a small closed-but-growable vocabulary (see `AutomationEvent.type`) —
/// today's four values are `"telemetry_ingestion"`, `"market_price_refresh"`,
/// `"automation_execution"`, `"automation_reconciliation"`. Written by each
/// route handler wrapping its own existing logic, not by the schedulers
/// themselves (the schedulers are just `curl` + `systemd` on the VM and have
/// no notion of this table) — "enabled", "next execution" and cadence are
/// derived from the known, documented systemd `OnCalendar` expressions, not
/// stored here.
model SchedulerRun {
  id String @id @default(cuid())

  schedulerName String

  startedAt  DateTime
  finishedAt DateTime?
  durationMs Int?

  status RunStatus

  errorMessage String?

  /// Small, run-specific outcome summary (e.g. connections processed,
  /// outcomes array) — same flexible-payload convention as
  /// `AuditLog.metadata`, so a new scheduler's own shape never needs a
  /// migration.
  summary Json?

  createdAt DateTime @default(now())

  @@index([schedulerName, startedAt])
}

/// Platform Health & Operations Center milestone (Sections 4/10, Historical/
/// Import Health). One row per actual data-import attempt — written from
/// inside the three existing shared importer entry points
/// (`synchronizeFusionSolarConnection`, `refreshMarketPrices`,
/// `ensureHistoricalRangeAvailable`), never from a page or route directly, so
/// every caller of those functions (scheduled or on-demand) is captured in
/// exactly one place per importer, with no duplicated logging logic.
/// `importerType` is a plain string for the same reason `SchedulerRun.schedulerName`
/// is — today's values are `"huawei_telemetry_sync"` (telemetry + daily KPI,
/// since `synchronizeFusionSolarConnection` always runs both together),
/// `"entsoe_market_price"`, and `"historical_range"`. `organizationId` is
/// null for `"entsoe_market_price"` runs, matching `MarketPrice`'s own
/// platform-wide (not tenant-scoped) nature.
model ImporterRun {
  id String @id @default(cuid())

  importerType String

  organizationId String?
  connectionId   String?

  startedAt  DateTime
  finishedAt DateTime?
  durationMs Int?

  status RunStatus

  rowsImported Int @default(0)
  rowsSkipped  Int @default(0)
  rowsFailed   Int @default(0)

  errorMessage String?

  /// Full, importer-specific outcome payload (per-plant counts, per-day
  /// breakdowns, etc.) — same flexible-payload convention as
  /// `AuditLog.metadata`/`SchedulerRun.summary`.
  details Json?

  createdAt DateTime @default(now())

  @@index([importerType, startedAt])
  @@index([organizationId, startedAt])
}

/// Platform Health & Operations Center milestone (Section 2, Huawei health).
/// One row per `callFusionSolarApi` call — the single shared FusionSolar
/// gateway client every caller in this app already funnels through (live
/// automation control, telemetry sync, historical backfill alike), so
/// instrumenting it here captures every real Huawei request with no
/// duplicated logging at each call site. `connectionId` (not
/// `organizationId`) — `FusionSolarConnection` is this function's own
/// parameter type and already carries `id`; resolving `organizationId` would
/// require widening that shared type for every existing caller, so admin
/// queries join through `FusionSolarConnection` instead. `retryCount` is
/// always `0` today (`callFusionSolarApi` does not retry) — recorded
/// honestly rather than omitted, so this column means something real the day
/// retry behavior is actually added, instead of being backfilled from
/// nothing.
model HuaweiRequestLog {
  id String @id @default(cuid())

  connectionId String

  apiPath String

  httpStatus Int?
  success    Boolean
  failCode   Int?

  /// The JS `Error.name` when the request failed before a response was ever
  /// received (network failure/abort) — `httpStatus` is null in that case.
  /// Never fabricated: absent entirely for a normal HTTP response, even an
  /// error one.
  errorName    String?
  errorMessage String?

  durationMs Int

  tokenRefreshed Boolean @default(false)
  retryCount     Int     @default(0)

  createdAt DateTime @default(now())

  @@index([connectionId, createdAt])
  @@index([apiPath, createdAt])
  @@index([httpStatus, createdAt])
}

/// Database-First Architecture milestone. Historical import status distinct
/// from `RunStatus` (used by `SchedulerRun`/`ImporterRun`, both one-shot
/// records of a single completed invocation) — a `HistoricalImportJob` is a
/// standing request that can span several invocations (bounded by
/// `importHistoricalRange`'s own time budget per call), so it needs
/// `RUNNING`/`PENDING` states those one-shot records never do.
enum HistoricalImportJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// Database-First Architecture milestone. Platform Admin's explicit
/// historical-import tool (`app/admin/historical-imports`) — the only other
/// place besides the one-time onboarding import
/// (`lib/onboarding/historical-import.ts`) allowed to trigger a Huawei/
/// ENTSO-E historical import; Dashboard/Market never do. One row per
/// admin-requested range; `importHistoricalRange` is idempotent and
/// resumable, so re-processing the same job (via the "Continue" action)
/// simply picks up whatever is still missing at zero cost for what's
/// already imported. `daysRequested`/`daysAvailable` mirror
/// `ImporterRun.rowsImported`'s meaning for this importer (days fully
/// available for every data type, not "days touched this call").
model HistoricalImportJob {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  rangeStart DateTime
  rangeEnd   DateTime

  status HistoricalImportJobStatus @default(PENDING)

  daysRequested Int @default(0)
  daysAvailable Int @default(0)

  lastRunAt DateTime?
  lastError String?

  createdByUserId String
  createdBy       User   @relation(fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
}

/// Which layer of the forecast hierarchy (Live Energy Forecast Integration
/// milestone) produced this interval — see `lib/forecast/forecast-tiers.ts`.
/// SHORT: real Open-Meteo weather forecast. MEDIUM: weather forecast
/// unavailable, physical/clear-sky model + calibration + analog days.
/// LONG: no weather forecast at all this far out — climatological analog
/// (day-of-year + daylight geometry + historical production shape only).
enum ForecastHorizonTier {
  SHORT
  MEDIUM
  LONG
}

/// Simple, non-statistical confidence label (Live Energy Forecast
/// Integration milestone) — never a fabricated precise percentage, see
/// `lib/forecast/forecast-tiers.ts`'s `classifyConfidence`.
enum ForecastConfidence {
  HIGH
  MEDIUM
  LOW
}

/// PV Generation Forecast persistence (Live Energy Forecast Integration
/// milestone). One row per (plantId, issuedAt, targetIntervalStart) — a
/// forecast VINTAGE, never overwritten once written. Only `actualKwh`/
/// `errorKwh`/`errorPct`/`reconciledAt` are ever updated after insert, once
/// the target interval has elapsed and real reconstructed Available PV
/// exists (`lib/forecast/forecast-persistence.ts`) — every other field is
/// immutable, so later analysis can always answer "what did we predict at
/// the time" instead of comparing reality against a forecast recomputed
/// after the fact.
model PvForecastRecord {
  id String @id @default(cuid())

  organizationId String
  plantId        String

  /// When this forecast was generated - identifies the vintage.
  issuedAt DateTime
  /// The 15-minute interval this row predicts.
  targetIntervalStart DateTime

  horizonTier     ForecastHorizonTier
  /// (targetIntervalStart - issuedAt) in minutes - the raw lead time this
  /// forecast was made at, for later "error by forecast horizon" analysis.
  leadTimeMinutes Int

  forecastKw  Decimal @db.Decimal(10, 3)
  forecastKwh Decimal @db.Decimal(10, 3)

  modelVersion  String
  weatherSource String

  confidence ForecastConfidence?

  /// Diagnostic inputs actually used for this interval - GHI, cloud cover,
  /// temperature, calibration factor, analog day dates/weight, clear-sky
  /// fallback flag, etc. Free-form (Json) since exactly what's captured
  /// evolves with the model, but always enough to reconstruct why this
  /// number came out the way it did.
  inputs Json

  /// Filled in once the interval has elapsed and reconstructAvailablePv has
  /// a real value for it - never historical export, see
  /// available-pv-reconstruction.ts. Null until reconciled.
  actualKwh    Decimal?  @db.Decimal(10, 3)
  errorKwh     Decimal?  @db.Decimal(10, 3)
  errorPct     Decimal?  @db.Decimal(8, 3)
  reconciledAt DateTime?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plant        Plant        @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([plantId, issuedAt, targetIntervalStart])
  @@index([plantId, targetIntervalStart])
  @@index([plantId, actualKwh])
  @@index([organizationId, plantId, issuedAt])
}

/// D+1 Self-Learning Forecast milestone (Aug 2026). Which trained-model
/// implementation produced a `ForecastModelVersion` — extensible: a future
/// family (e.g. a probabilistic layer, a different tree library) is a new
/// enum value, never a schema rewrite. `PHYSICAL_BASELINE` and
/// `RIDGE_REGRESSION` exist so the current production pipeline and the
/// Phase 1 offline experiment can both be represented in the same registry
/// for direct comparison, even though neither is ONNX-backed.
enum ForecastModelFamily {
  PHYSICAL_BASELINE
  RIDGE_REGRESSION
  LIGHTGBM
  XGBOOST
}

/// Lifecycle state of one `ForecastModelVersion` in the champion/challenger
/// system. Exactly one CHAMPION is expected globally at a time (not DB-
/// enforced — see `lib/forecast/ml/model-registry.ts` for why a partial
/// unique index isn't used here); CANDIDATE rows are pending walk-forward
/// evaluation, REJECTED rows keep their `rejectionReason` permanently for
/// audit, RETIRED marks a former champion superseded by a later promotion.
enum ForecastModelStatus {
  CANDIDATE
  CHAMPION
  REJECTED
  RETIRED
}

/// Mirrors `lib/forecast/forecast-tiers.ts`'s `WeatherRegime` TS type
/// exactly (kept in sync manually — see that type's own doc comment). A
/// real Prisma enum (not buried in a Json blob) specifically so the
/// monitoring page and promotion-gate evaluation can group/filter by
/// regime with an indexed query instead of scanning Json.
enum WeatherRegime {
  CLEAR
  PARTLY_CLOUDY
  CLOUDY
  RAPIDLY_CHANGING
  UNKNOWN
}

/// D+1 Self-Learning Forecast milestone. The model registry — every trained
/// candidate, whether it ever became champion or not, is a permanent row
/// here. This is deliberately the single source of truth for "what model
/// produced this forecast" (`MlForecastRecord.modelVersionId`) and "why was
/// a candidate rejected" (`rejectionReason`), per this milestone's own
/// requirement to never have an opaque "current model.bin".
///
/// Two-stage architecture (magnitude + shape correction, per this
/// project's own validated Phase 1 finding that two-stage beat one unified
/// model on real data): both ONNX artifacts live on the same row, since a
/// "model version" is the pair together, never independently versioned.
/// Storing the ONNX bytes directly in Postgres (not a file path, not a
/// separate blob-storage product) is a deliberate choice: this repo's
/// production forecast/inference runtime is a stateless Vercel deployment
/// with no persistent local filesystem to read a trained-model file back
/// from between requests, and Postgres is already the single source of
/// truth for everything else in this system (calibration factors, market
/// prices, telemetry) — no new storage service introduced for this.
model ForecastModelVersion {
  id String @id @default(cuid())

  /// Human-readable, e.g. "lightgbm-xgboost-2026-08-12-coldstart" -
  /// assigned at training time, never reused.
  versionLabel String @unique

  family ForecastModelFamily
  status ForecastModelStatus @default(CANDIDATE)

  magnitudeModelOnnx Bytes
  shapeModelOnnx     Bytes

  /// Checked against the live feature builder's own
  /// `FEATURE_SCHEMA_VERSION` at inference time - a mismatch throws rather
  /// than silently running a mismatched feature vector through the model.
  featureSchemaVersion String

  hyperparameters Json

  trainingDataStart      DateTime
  trainingDataEnd        DateTime
  trainingSampleCount    Int
  trueVintageSampleCount Int
  plantsCovered          String[]

  /// Full walk-forward holdout metric suite (overall, per-plant, per-
  /// weather-regime, per-horizon-tier, stage1/stage2 head-to-head) - see
  /// `lib/forecast/ml/promotion.ts`'s `ValidationMetrics` type for the
  /// exact shape this is read back as.
  validationMetrics Json

  promotedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())

  mlForecastRecords MlForecastRecord[]

  @@index([status, createdAt])
  @@index([family, status])
}

/// D+1 Self-Learning Forecast milestone. The ML pipeline's own forecast
/// table - entirely separate from `PvForecastRecord` (the physical+hand-
/// tuned production pipeline), so this system can run, be monitored, and
/// be reconciled against real outcomes with zero risk of ever touching a
/// value the Dashboard/Market pages actually render.
model MlForecastRecord {
  id String @id @default(cuid())

  organizationId String
  plantId        String
  modelVersionId String

  /// When this forecast was generated - identifies the vintage, same
  /// convention as `PvForecastRecord.issuedAt`.
  issuedAt DateTime
  /// The 15-minute interval this row predicts.
  targetIntervalStart DateTime

  /// (targetIntervalStart - issuedAt) in minutes - the raw lead time this
  /// forecast was made at.
  leadTimeMinutes Int
  horizonTier     ForecastHorizonTier

  /// The physical-model forecast for this same interval, kept alongside
  /// the ML output so every row can show its own baseline-vs-corrected
  /// comparison without a join.
  physicalForecastKw Decimal @db.Decimal(10, 3)
  mlForecastKw       Decimal @db.Decimal(10, 3)
  mlForecastKwh      Decimal @db.Decimal(10, 3)

  weatherRegime WeatherRegime

  /// The exact numeric feature vector fed to the model for this row -
  /// permanent audit trail for "why did the model predict this," per this
  /// project's explainability principle.
  featureVector Json

  /// Filled in once the interval has elapsed and reconstructAvailablePv
  /// has a real value for it. Null until reconciled.
  actualKwh    Decimal?  @db.Decimal(10, 3)
  errorKwh     Decimal?  @db.Decimal(10, 3)
  errorPct     Decimal?  @db.Decimal(8, 3)
  reconciledAt DateTime?

  createdAt DateTime @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plant        Plant                @relation(fields: [plantId], references: [id], onDelete: Cascade)
  modelVersion ForecastModelVersion @relation(fields: [modelVersionId], references: [id])

  @@unique([plantId, modelVersionId, issuedAt, targetIntervalStart])
  @@index([plantId, targetIntervalStart])
  @@index([plantId, actualKwh])
  @@index([modelVersionId])
  @@index([weatherRegime])
}
